{
  "name": "active-inference-typescript",
  "version": "1.0.0",
  "description": "Type-safe Active Inference implementation in TypeScript",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "demo": "tsx src/demos/ant-colony-demo.ts",
    "lint": "eslint .",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "active-inference",
    "free-energy-principle",
    "bayesian-inference",
    "artificial-intelligence",
    "typescript",
    "type-safety"
  ],
  "author": "ActiveInferAnts",
  "license": "MIT",
  "dependencies": {
    "mathjs": "^15.2.0",
    "plotly.js": "^4.3.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.14.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
