{
  "name": "active-inference-typescript",
  "version": "1.0.0",
  "description": "Type-safe Active Inference implementation in TypeScript",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "demo": "ts-node src/demos/ant-colony-demo.ts",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "active-inference",
    "free-energy-principle",
    "bayesian-inference",
    "artificial-intelligence",
    "typescript",
    "type-safety"
  ],
  "author": "ActiveInferAnts",
  "license": "MIT",
  "dependencies": {
    "mathjs": "^15.2.0",
    "plotly.js": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "jest": "^30.5.2",
    "ts-node": "^10.9.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
